# Local development template. Copy it and edit as needed:
#
#   cp .env.example .env
#
# `.env` is git-ignored, so your local values never get committed.
#
# Who reads what:
#   - DATABASE_URL   is read by the sqlx CLI (`sqlx migrate run`, `cargo sqlx
#                    prepare`) and by the compile-time query macros. The sqlx CLI
#                    loads a `.env` file automatically. Defaults match
#                    docker-compose.yml.
#   - The service does NOT read `.env`. It reads APP_-prefixed variables from the
#                    process environment; export them in your shell, e.g.
#                      export APP_DATABASE__URL="$DATABASE_URL"
#                      export APP_AUTH__JWT_SECRET="$(openssl rand -base64 48)"
#                    See README "Run locally" and "Using an existing Postgres".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/master_data
